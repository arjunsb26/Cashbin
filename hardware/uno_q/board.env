# Settings for board_up.sh, read on the bin's own Linux side.
#
# The only one that usually changes is LAPTOP_IP. On a Windows mobile hotspot the laptop
# is almost always 192.168.137.1. Check it with hardware\find_laptop_ip.ps1 on the laptop,
# which prints the address and the whole command to run here.
#
# An argument to board_up.sh beats whatever is in this file:
#
#   ./board_up.sh 192.168.137.1

LAPTOP_IP=192.168.137.1

# The backend's plain port. 8443 is the secure one and it exists for a phone browser,
# which neither of these two programs is.
LAPTOP_PORT=8000

# Which camera index the Brio opens on. `python3 webcam_client.py --list` prints the ones
# that give a frame, with the resolution of each.
CAMERA_INDEX=0

# Where bridge.py gets its weights. `bridge` is the real one, through the sketch. `fake`
# is a noisy baseline that needs no hardware and is the quickest way to prove the network
# before the load gauge is wired.
BIN_SOURCE=bridge

# Frames a second the webcam sends. Eight is the number the backend expects.
CAMERA_FPS=8

# Where the two programs live. Change only if you put them somewhere else.
BIN_HOME=/home/arduino
